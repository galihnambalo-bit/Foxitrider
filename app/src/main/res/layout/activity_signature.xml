<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"/>

    <!-- Color & stroke controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Warna:"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnColorBlack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:backgroundTint="#000000"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnColorBlue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:backgroundTint="#1565C0"
            android:alpha="0.5"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnColorRed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:backgroundTint="#D32F2F"
            android:alpha="0.5"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tebal:"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"/>

        <SeekBar
            android:id="@+id/seekStroke"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="18"
            android:progress="3"/>

    </LinearLayout>

    <!-- Instruction -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✍️ Gambar tanda tangan Anda di bawah ini:"
        android:textSize="13sp"
        android:textColor="@color/colorTextSecondary"
        android:padding="8dp"
        android:background="@color/colorBackground"/>

    <!-- Signature canvas -->
    <com.foxitrider.ui.views.SignatureView
        android:id="@+id/signatureView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:layout_margin="8dp"
        android:elevation="4dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/colorSurface">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🗑️ Hapus &amp; Ulangi"
            android:backgroundTint="@color/colorTextSecondary"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSaveSignature"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🎬 Tonton Iklan &amp; Tambah ke PDF"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSaveImage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🖼️ Simpan TTD sebagai Gambar (Gratis)"
            android:backgroundTint="@color/colorSurface"
            android:textColor="@color/colorPrimary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>
</LinearLayout>
